DATABASE_URL=postgresql://user:password@localhost:5432/foliocraft
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional versioned encryption keys; leave empty until a reviewed rotation.
BETTER_AUTH_SECRETS=
# False is allowed only explicitly in development/test.
ADMIN_REQUIRE_MFA=true
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
PORT=4000
NODE_ENV=development
HOST=127.0.0.1
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
# Exact reverse proxy socket addresses only; proxy must overwrite x-real-ip.
TRUSTED_PROXY_IPS=
# R2 bucket stays private; all four required together when enabling uploads.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
# Optional during development, required in production for verified signup/reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
## Keep false for production; true is only for the human-authorized friends-only trial.
TRIAL_SKIP_EMAIL_VERIFICATION=false

# Dedicated sensitive-action operator-password failures (independent of private writes).
ADMIN_PASSWORD_MAX_FAILURES=5
ADMIN_PASSWORD_WINDOW_SECONDS=900
ADMIN_PASSWORD_BLOCK_SECONDS=900

# Server-only random salt, at least 32 characters. Required in production.
# Without it, local report intake returns REPORTING_UNAVAILABLE.
REPORT_IP_SALT=

# Bounded administration identifier-only audit exports (1..10000).
ADMIN_AUDIT_EXPORT_MAX_ROWS=1000
# Non-secret build identifier; defaults to unknown until supplied by the build operator.
BUILD_VERSION=unknown
# Operational request deadline placeholder; legal confirmation required before live use.
DATA_REQUEST_DUE_DAYS=30
# Total account + sites + inquiry rows; oversize exports fail without partial downloads.
DATA_REQUEST_EXPORT_MAX_ROWS=1000
DATA_REQUEST_EXPORT_MAX_BYTES=1048576
