# Local development defaults. For the custom-domain build, set:
# NEXT_PUBLIC_API_URL=https://api.lord2ve.tech
# NEXT_PUBLIC_WEB_URL=https://lord2ve.tech
# Runtime SSR: API_URL=https://api.lord2ve.tech
# NEXT_PUBLIC values are compiled at build time; runtime changes do not replace them.
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
