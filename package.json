{
	"name": "ichnara",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev:web": "bun run --cwd apps/web dev",
		"dev:api": "bun run --cwd apps/api dev",
		"db:generate": "bun run --cwd apps/api db:generate",
		"db:migrate": "bun run --cwd apps/api db:migrate",
		"typecheck": "bun run --cwd apps/api typecheck && bun run --cwd apps/web typecheck",
		"test": "bun scripts/test-api.ts",
		"test:web": "bun test --cwd apps/web tests",
		"test:worker-storage": "bun scripts/test-worker-storage.ts",
		"build": "bun run --cwd apps/web build",
		"check": "biome check .",
		"format": "biome check --write .",
		"db:backup": "bun run --cwd apps/api db:backup",
		"db:verify-restore": "bun run --cwd apps/api db:verify-restore"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "1.4.3",
		"typescript": "7.0.2",
		"wrangler": "4.151.0"
	},
	"patchedDependencies": {
		"@opennextjs/cloudflare@1.20.11": "patches/@opennextjs%2Fcloudflare@1.20.11.patch"
	},
	"overrides": {
		"@node-minify/core": {
			"glob": "10.5.0"
		},
		"@esbuild-kit/core-utils": {
			"esbuild": "0.25.12"
		}
	}
}
